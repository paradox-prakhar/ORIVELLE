# Node.js Server & Application Environment
PORT=3001
NODE_ENV=development
DATABASE_PATH=data/hanbit.sqlite
# PostgreSQL Database URL (when deploying to PostgreSQL with Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/orivelle?schema=public

# Permitted Browser Origins (CORS & CSRF origin enforcement)
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001

# Demo catalog seeding (set false for empty catalog on fresh store setup)
SEED_DEMO=true

# Administrator Initial Provisioning (run: npm run admin:create)
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=your_strong_admin_password_min_10_chars
ADMIN_NAME=Store Administrator

# Razorpay Payment Gateway Configuration (India)
# Retrieve from Razorpay Dashboard: Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Retrieve from Razorpay Dashboard: Settings > Webhooks
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Transactional Email Service (Resend / SendGrid / Postmark / SMTP)
# Set to 'true' once real email dispatch credentials are wired
EMAIL_CONFIGURED=false

# Shopify Storefront API Configuration
# Optional: connect your Shopify catalog for live synced pieces
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token
SHOPIFY_API_VERSION=2026-10
