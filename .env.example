# Node.js 24.13+ is required. Copy to .env; never commit credentials.
PORT=3001
# Set HOST=0.0.0.0 only when deploying behind your hosting platform's HTTPS proxy.
HOST=127.0.0.1
# Enable only for a known reverse-proxy topology, e.g. 1 for a single trusted proxy.
TRUST_PROXY_HOPS=0
DATABASE_PATH=data/hanbit.sqlite
# Browser origins permitted to make authenticated changes. Match your final HTTPS domain.
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
NODE_ENV=development
SEED_DEMO=true

# Set only when running npm run admin:create. No default administrator exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Store administrator

# Online payments, email delivery, image uploads, and courier integrations are not enabled.
# This build implements COD and locally stored newsletter consent only.
# Configure and implement verified provider integrations before enabling real online payments.
